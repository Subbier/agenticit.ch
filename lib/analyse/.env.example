# --- KI-Analyse-Backend (app/api/analyse) ---
# Diese Variablen gehören in die .env.local von v1-main (NICHT committen).

# SEMrush (Standard-API, https://www.semrush.com/api-analytics/)
SEMRUSH_API_KEY=

# SMTP-Versand des PDF-Reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AgenticIT <noreply@agenticit.ch>
# Optionale interne Kopie jeder Analyse:
MAIL_BCC=

# Zoho-Lead-Weiterleitung (bestehender Webhook, identisch zu /api/leads)
LEADS_WEBHOOK_URL=
