# Zoho-Lead-Weiterleitung (Kontaktformular + KI-Analyse)
LEADS_WEBHOOK_URL=

# Zoho-People-Weiterleitung (Karriereseite /karriere → Recruitment-Modul)
KARRIERE_WEBHOOK_URL=

# --- KI-Analyse-Backend (POST /api/analyse) ---
# SEMrush Standard-API: https://www.semrush.com/api-analytics/
SEMRUSH_API_KEY=

# SMTP-Versand des PDF-Reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AgenticIT <noreply@agenticit.ch>
MAIL_BCC=

# Optional: pro Seite in lib/subpage-content.ts (z. B. RevOps voiceAgent)
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Separate Lead-Terminierungs-Demo /beste-variante (keine FAIR-/GlobalSana-Leadroute)
# Erst nach CRM-, Anruf- und Kalenderprüfung aktivieren.
TESTLEADS_ENABLED=false
TESTLEADS_CRM_GATEWAY_URL=
# Base64 aus Aircall API-ID:API-Token; nur serverseitig speichern.
TESTLEADS_AIRCALL_API_KEY=
# Bestehender Vercel Redis und geschützter Minuten-Worker.
KV_REST_API_URL=
KV_REST_API_TOKEN=
CRON_SECRET=
